# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts
#
# Operator scripts are local by default. Two exceptions, both because
# something outside this machine has to be able to run them from a checkout
# that has only what is in the repository: the demo reset (#604), which
# .github/workflows/demo-reset.yml runs on a schedule, and the tenant CLI
# (#795), which package.json aliases as `tenant:*` and docs/tenants.md tells
# an operator to run, and the places seed builder (#1699), which
# `places:seed` runs to regenerate a committed migration, with its two
# companions `places:overlays` and `places:neighborhoods` (#1700). test/scripts-hygiene.test.ts fails the unit suite when
# a package.json alias or a runbook names a scripts/ file that is not
# allowlisted below, so the next one cannot ship uncommitted (#799).
scripts/*
!scripts/demo/
!scripts/demo-reset.ts
!scripts/tenant/
!scripts/tenant-cli.ts
!scripts/places/
!scripts/places-seed.ts
!scripts/places-overlays.ts
!scripts/places-neighborhoods.ts

# playwright
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
/e2e/screenshots/
/.playwright-cli/
/e2e/a11y-report.json

# supabase data backups (may contain live secrets, never commit)
supabase/backups/

# claude code (local overrides)
.claude/settings.local.json
